{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "convex dev --start \"npm run dev:next\"",
    "dev:next": "next dev",
    "convex:dev": "convex dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "check": "npm run check:mui-allowlist && npm run lint && npm run build && npm audit --omit=dev",
    "check:full": "npm run check && npm run test:cloudflare-auth && npm run test:team && npm run test:files && npm run verify:team && npm run verify:browser && npm run verify:prod",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test:workspace-page": "vitest run --config vitest.workspace-page.config.ts",
    "test:cloudflare-auth": "vitest run --config vitest.providers.config.ts",
    "check:workspace-layout": "node scripts/check-workspace-layout.mjs",
    "check:mui-allowlist": "node scripts/check-mui-allowlist.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:relay": "node scripts/verify-relay-rebuild.mjs",
    "verify:team": "node scripts/verify-team.mjs",
    "test:team": "vitest run convex/team.test.ts",
    "test:files": "vitest run convex/projectFiles.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "verify:team:live": "node scripts/verify-team-live.mjs",
    "verify:browser": "node scripts/verify-browser-smoke.mjs",
    "verify:cloudflare-auth": "node scripts/verify-cloudflare-auth.mjs",
    "verify:light-highlights": "node scripts/verify-light-highlights.mjs",
    "verify:light-logo": "node scripts/verify-light-logo.mjs",
    "verify:ui": "node scripts/verify-ui-interactions.mjs",
    "verify:prod": "node scripts/verify-production.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1093.0",
    "@aws-sdk/s3-request-presigner": "^3.1093.0",
    "@clerk/nextjs": "^7.4.2",
    "@dnd-kit/core": "^6.3.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.3.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.39.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.18.0",
    "motion": "^12.40.0",
    "next": "^16.0.4",
    "radix-ui": "^1.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "^8.5.15",
    "sharp": "0.35.3",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@clerk/testing": "^2.1.1",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "convex-test": "^0.0.53",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wrangler": "^4.120.0"
  }
}
