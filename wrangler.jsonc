{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "relay",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": true,
  "vars": {
