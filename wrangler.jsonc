    "NEXT_PUBLIC_CONVEX_URL": "https://spotted-pheasant-146.convex.cloud",
    "NEXT_PUBLIC_FILE_STORAGE_PROVIDER": "convex",
    "NEXT_PUBLIC_SITE_URL": "https://relay-dev.cc.cd",
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
}
