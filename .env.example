# Convex deployment URL used by the Next.js client.
# Running `npm run dev` can populate this value for your development deployment.
NEXT_PUBLIC_CONVEX_URL=

# Public canonical URL for metadata, robots.txt, and sitemap.xml.
# Set this to the production Cloudflare Worker custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Reserved for the upcoming Cloudflare R2 storage feature. Keep this as convex
# until R2 is officially enabled.
NEXT_PUBLIC_FILE_STORAGE_PROVIDER=convex

# Future Cloudflare R2 S3-compatible credentials. Do not configure these yet;
# set them in the Convex deployment environment when R2 is released.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Clerk publishable key exposed to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Keep false until Clerk Billing is connected to the production Stripe account.
NEXT_PUBLIC_BILLING_PURCHASES_ENABLED=false

# Clerk secret key used only by the Next.js server.
CLERK_SECRET_KEY=

# Temporary server-only password wall shown before the app and Clerk sign-in.
# Use a long, unique value and configure it in every hosted environment.
ACCESS_WALL_PASSWORD=

# Clerk issuer domain used by Convex to validate authentication tokens.
# Set this in your Convex deployment environment. CLERK_FRONTEND_API_URL is
# preferred; CLERK_JWT_ISSUER_DOMAIN is supported as a fallback.
CLERK_FRONTEND_API_URL=
# CLERK_JWT_ISSUER_DOMAIN=
